{
  "manifest_version": 3,
  "name": "PingLater — WhatsApp Follow-up & Batch Workspace",
  "short_name": "PingLater",
  "version": "1.0.0",
  "description": "Never forget a follow-up. Organize contacts, prepare personalized messages in batches, schedule reminders, and send through WhatsApp Web.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "PingLater — Open WhatsApp Follow-up Workspace",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "tabs",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*",
    "https://docs.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sounds/chime.wav",
        "assets/icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
